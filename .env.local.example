NEXT_PUBLIC_API_URL=http://localhost:8000/api
# Keep `header` until the backend is in dual mode. Production cookie mode also
# requires NEXT_PUBLIC_API_URL=https://api.hocamozelders.com/api.
NEXT_PUBLIC_AUTH_MODE=header
NEXT_PUBLIC_LEARNING_PLANS_ENABLED=false
NEXT_PUBLIC_NEW_TUTOR_LAUNCH_PROGRAM_ENABLED=false
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# The /hoca-bul tutor-matching flow. Off by default: with this unset or false,
# /hoca-bul and /hoca-bul/sonuclar return 404 and the authenticated student home
# keeps its original subject search.
#
# Read at build time (NEXT_PUBLIC_*), so changing it requires a rebuild — in
# every environment, in both directions.
NEXT_PUBLIC_HOCA_BUL_ENABLED=false

# Optional isolated contact backend for local development.
# NEXT_PUBLIC_CONTACT_API_URL=http://localhost:8107/api/support/contact/
